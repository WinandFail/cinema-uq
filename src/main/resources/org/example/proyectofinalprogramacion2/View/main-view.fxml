<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.proyectofinalprogramacion2.View.MainController"
      spacing="10" style="-fx-padding: 20;">

    <Label text="CinemaUQ" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    <Label fx:id="statusLabel" text="Loading..."/>

    <HBox spacing="10">
        <Button text="Buy tickets" onAction="#onBuyTickets"/>
        <Button text="Redeem points" onAction="#onRedeemPoints"/>
        <Button text="Open reports" onAction="#onOpenReports"/>
    </HBox>

    <TextArea fx:id="outputArea" prefHeight="400" editable="false"/>
</VBox>