<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.proyectofinalprogramacion2.View.ReportController"
      spacing="10" style="-fx-padding: 20;">

    <Label text="Reports" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <ComboBox fx:id="formatCombo"/>
        <Button text="Generate" onAction="#onGenerate"/>
    </HBox>

    <TextArea fx:id="reportArea" prefHeight="300" editable="false"/>
</VBox>