<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.proyectofinalprogramacion2.View.SeatsController"
      spacing="15" style="-fx-padding: 20;" alignment="CENTER">

    <Label text="Selecciona tus Asientos" styleClass="title-text"/>

    <!-- PANTALLA EN NEGRO -->
    <Label text="PANTALLA" style="-fx-background-color: black; -fx-text-fill: #C1E0DF; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-padding: 10px 150px; -fx-border-radius: 20px; -fx-background-radius: 20px;"/>

    <GridPane fx:id="seatsGrid" alignment="CENTER" hgap="8" vgap="8" style="-fx-padding: 15px;"/>

    <Label fx:id="selectedSeatsLabel" text="Asientos seleccionados: 0" style="-fx-font-size: 16px;"/>
    <Label fx:id="totalPointsLabel" text="Puntos a ganar: ⭐ 0 pts" style="-fx-font-size: 16px;"/>

    <Button text="CONTINUAR A CONFITERÍA" onAction="#onContinueToConcession" prefWidth="300"/>
</VBox>