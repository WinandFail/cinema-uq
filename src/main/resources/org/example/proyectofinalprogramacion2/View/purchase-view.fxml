<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.proyectofinalprogramacion2.View.PurchaseHistoryController"
      spacing="20" style="-fx-padding: 30;" alignment="CENTER">

    <Label text="MI HISTORIAL DE COMPRAS" styleClass="title-text"/>

    <TableView fx:id="purchaseTable" prefHeight="300" prefWidth="650">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="100"/>
            <TableColumn fx:id="colDate" text="Fecha Función" prefWidth="150"/>
            <TableColumn fx:id="colTotal" text="Total" prefWidth="100"/>
            <TableColumn fx:id="colPoints" text="Puntos" prefWidth="100"/>
            <TableColumn fx:id="colStatus" text="Estado" prefWidth="120"/>
        </columns>
    </TableView>

    <Button text="CERRAR" onAction="#onClose" prefWidth="150"/>
</VBox>