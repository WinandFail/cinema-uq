<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.proyectofinalprogramacion2.View.DecoratorController"
      spacing="10" style="-fx-padding: 20;">
    <Label text="Decorator: Reembolso Parcial" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <TextField fx:id="totalField" promptText="Total pagado (ej: 50000)"/>
    <Button text="Calcular Reembolso" onAction="#calculateRefund"/>
    <TextArea fx:id="logArea" prefHeight="150" editable="false"/>
</VBox>