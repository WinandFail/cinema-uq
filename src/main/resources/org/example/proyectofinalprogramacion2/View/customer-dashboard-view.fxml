<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.proyectofinalprogramacion2.View.CustomerDashboardController"
      spacing="20" style="-fx-padding: 30;" alignment="CENTER">

    <Label text="PANEL DE CLIENTE" styleClass="title-text"/>
    <Label fx:id="statusLabel" text="Cargando datos..." style="-fx-font-size: 16px;"/>

    <HBox spacing="20" alignment="CENTER">
        <Button text="CARTELERA" onAction="#onOpenCartelera" prefWidth="180"/>
        <Button text="CANCELAR" onAction="#onCancelPurchase" prefWidth="180"/>
    </HBox>

    <HBox spacing="20" alignment="CENTER">
        <Button text="HISTORIAL" onAction="#onOpenPurchaseHistory" prefWidth="180"/>
        <Button text="MOVIMIENTOS" onAction="#onOpenTransactionHistory" prefWidth="180"/>
    </HBox>

    <Label text="REGISTRO DE ACTIVIDAD" style="-fx-font-size: 18px; -fx-padding: 15px 0 0 0;"/>
    <TextArea fx:id="outputArea" prefHeight="250" prefWidth="650" editable="false"/>
</VBox>