<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.proyectofinalprogramacion2.View.CarteleraController"
      spacing="15" style="-fx-padding: 20;">
    <Label text="Cartelera CinemaUQ" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <TableView fx:id="movieTable" prefHeight="300">
        <columns>
            <TableColumn fx:id="colTitle" text="Película" prefWidth="200"/>
            <TableColumn fx:id="colRoom" text="Sala" prefWidth="100"/>
            <TableColumn fx:id="colTime" text="Horario" prefWidth="150"/>
            <TableColumn fx:id="colPrice" text="Precio" prefWidth="100"/>
        </columns>
    </TableView>

    <Button text="Seleccionar Función y Comprar Asientos" onAction="#onSelectScreening" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
</VBox>