<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.proyectofinalprogramacion2.View.CarteleraController"
      spacing="20" style="-fx-padding: 20;" alignment="CENTER">

    <Label text="CARTELERA" styleClass="title-text"/>

    <TableView fx:id="movieTable" prefHeight="350" prefWidth="800" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTitle" text="Película" prefWidth="250"/>
            <TableColumn fx:id="colRoom" text="Sala" prefWidth="100"/>
            <TableColumn fx:id="colTime" text="Horario" prefWidth="150"/>
            <TableColumn fx:id="colPrice" text="Precio" prefWidth="100"/>
            <TableColumn fx:id="colPoints" text="Puntos" prefWidth="100"/>
        </columns>
    </TableView>

    <HBox spacing="20" alignment="CENTER">
        <Button text="COMPRAR ASIENTOS" onAction="#onSelectScreening" prefWidth="250"/>
        <Button text="PUNTOS" onAction="#onCheckPoints" prefWidth="150"/>
    </HBox>
</VBox>